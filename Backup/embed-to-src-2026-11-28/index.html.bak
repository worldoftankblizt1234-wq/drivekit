<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no" />
<meta name="theme-color" content="#0f172a" />
<link rel="manifest" href="../manifest.webmanifest" />
<link rel="icon" href="../assets/icons/icon-192.png" />
<link rel="apple-touch-icon" href="../assets/icons/apple-touch-icon.png" />
<title>DriveKit — Mọi hành trình, một giải pháp</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&family=Fira+Code:wght@500;600;700&display=swap&subset=vietnamese" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
<link rel="stylesheet" href="data:text/css;base64," />
    <link rel="canonical" href="https://drive-kit.pages.dev/map/">
</head>
<body>
<div class="loading-screen" id="loadingScreen">
  <div class="spinner"></div>
  <div style="text-align:center;">
    <h2 style="color:var(--text); margin-bottom:8px;">DriveKit</h2>
    <p class="loading-text" id="loadingText">Đang khởi tạo hệ thống...</p>
    <div class="loading-percent" id="loadingPercent">0%</div>
  </div>
</div>
<div class="auth-screen hidden" id="authScreen">
  <div class="auth-box">
    <h2 id="authTitle">DriveKit 🚌</h2>
    <p id="authSubtitle">Mọi hành trình, một giải pháp</p>
    <button class="btn-auth btn-google" id="btnGoogleAuth"><i class="fab fa-google"></i> Đăng nhập bằng Google</button>
    <div style="text-align:center; color:var(--text-muted); margin: 16px 0; font-size:0.85rem;">hoặc dùng Email</div>
    <div id="authError" style="color:var(--danger); font-size:0.85rem; margin-bottom:10px; display:none; text-align:center; font-weight:600;"></div>
    <input type="email" id="authEmail" class="auth-input" placeholder="Email" />
    <input type="password" id="authPassword" class="auth-input" placeholder="Mật khẩu" />
    <button class="btn-auth btn-email" id="btnSubmitAuth">Đăng nhập</button>
    <div style="text-align:center; margin-top:16px; font-size:0.9rem;">
      <span id="authToggleText" style="color:var(--text-muted);">Chưa có tài khoản?</span>
      <a href="#" id="authToggleBtn" style="color:var(--primary); font-weight:700; text-decoration:none; margin-left:5px;">Đăng ký ngay</a>
    </div>
  </div>
</div>
<div id="appUI" class="hidden">
  <div id="map"></div>
  <div class="floating-search" id="searchBar" onclick="activateSearch('view')">
    <i class="fas fa-search"></i>
    <input type="text" id="topSearchInput" placeholder="Tìm địa điểm hoặc dán link Google Maps..." readonly />
    <i class="fas fa-times search-clear-btn hidden" id="searchClearBtn" onclick="event.stopPropagation(); clearTopSearch()"></i>
  </div>
  <button class="fab-menu" id="mainMenuBtn" onclick="openMenu()"><i class="fas fa-bars"></i></button>
  <button class="fab-locate" id="mainLocateBtn" onclick="centerToLocation()"><i class="fas fa-location-arrow"></i></button>
  <button type="button" class="wx-chip" id="wxChip" style="display:none" onclick="wxToggleSheet()"><span id="wxChipIcon"><i class="fas fa-cloud-sun"></i></span><span id="wxChipText">--</span></button>
  <div class="wx-card" id="wxCard" style="display:none">
    <div class="wx-card-head"><span>Thời tiết tại vị trí của bạn</span><button type="button" class="wx-card-x" onclick="wxCloseCard()">✕</button></div>
    <div class="wx-card-main"><span id="wxCardIcon"></span><span id="wxCardTemp">--°</span><span id="wxCardDesc">—</span></div>
    <div class="wx-card-grid"><span>Cảm giác như <b id="wxCardFeels">--°</b></span><span>Độ ẩm <b id="wxCardHum">--%</b></span><span>Gió <b id="wxCardWind">-- m/s</b></span><span>Mưa 3h tới <b id="wxCardPop">--%</b></span></div>
    <div class="wx-card-hours" id="wxCardHours"></div>
  </div>
  <div id="wxSheet" style="display:none">
    <div id="wxSheetHandle"><span id="wxSheetGrip"></span><button type="button" id="wxSheetX" onclick="wxCloseSheet()">✕</button></div>
    <iframe id="wxFrame" title="Thời tiết DriveKit"></iframe>
  </div>
  <div class="wx-drive-strip" id="wxDriveStrip" style="display:none"><i class="fas fa-cloud-rain"></i><span id="wxDriveStripText"></span></div>
  <div id="wxNavBar" style="display:none" onclick="wxToggleSheet()"><div class="wxnb-main"><span id="wxNavBarMain">…</span><button type="button" id="wxNavBarToggle" onclick="event.stopPropagation();wxToggleNavBar()" aria-label="Mở rộng thời tiết">^</button></div><div class="wxnb-rows" id="wxNavBarRows" style="display:none"><div class="wxnb-row" id="wxNavBarRowCur"></div><div class="wxnb-row" id="wxNavBarRowRoute"></div><div class="wxnb-row" id="wxNavBarRowDest"></div></div></div>
  <button class="fab-layers" id="btnLayerMenu" onclick="event.stopPropagation(); toggleLayerMenu()" title="Lớp bản đồ"><i class="fas fa-layer-group"></i></button>
  <button class="fab-compass" id="btnCompass" onclick="resetNorth()" title="La bàn — Bấm để về hướng Bắc">
    <div class="compass-bg"></div>
    <svg id="compassNeedle" viewBox="0 0 24 24" class="compass-needle"><path d="M12 2L15 12H9L12 2Z" fill="#ef4444"/><path d="M12 22L9 12H15L12 22Z" fill="#cbd5e1"/></svg>
  </button>
  <button class="fab-layers" id="btnQuickPin" onclick="event.stopPropagation(); openQuickPin()" style="bottom: calc(140px + var(--safe-bottom)); right: 16px; left: auto; background: var(--success); color: white; border: none; box-shadow: 0 4px 15px rgba(16,185,129,0.4);" title="Ghim nhanh vị trí"><i class="fas fa-map-marker-alt"></i></button>
  <button class="fab-rest-stop-filter" id="btnRestStopFilter" onclick="toggleRestStopFilter()" title="Hiện/ẩn trạm dừng nghỉ" style="bottom: calc(200px + var(--safe-bottom));"><i class="fas fa-bed"></i></button>
  <button class="fab-layers" id="btnNearbySearch" onclick="openNearbySearchPanel()" style="bottom: calc(260px + var(--safe-bottom)); right: 16px; left: auto; background: var(--warning); color: white; border: none; box-shadow: 0 4px 15px rgba(245,158,11,0.4);" title="Tìm kiếm xung quanh"><i class="fas fa-street-view"></i></button>
  <div class="layer-menu" id="layerMenu">
    <button class="layer-option active" onclick="changeLayer('trackasia-maplibre', this)"><div class="layer-title"><i class="fas fa-map"></i> 1. TrackAsia + MapLibre</div><div class="layer-desc">Vector TrackAsia</div></button>
    <button class="layer-option" onclick="changeLayer('maptiler', this)"><div class="layer-title"><i class="fas fa-map-marked-alt"></i> 2. MapTiler Streets V4 + MapLibre</div><div class="layer-desc">Key: aEzMCP0ANRz52vd1RvrW</div></button>
    <button class="layer-option" onclick="changeLayer('satellite', this)"><div class="layer-title"><i class="fas fa-satellite"></i> 3. Vệ tinh</div><div class="layer-desc">MapTiler Hybrid</div></button>
    <hr style="border: 0; border-top: 1px solid var(--border); margin: 4px 0;">
    <div style="display:flex; align-items:center; justify-content:space-between; padding: 8px 14px;">
      <div class="layer-title" style="font-size: 0.85rem; font-weight: 700; color: var(--text);"><i class="fas fa-traffic-light" style="color: #ef4444;"></i> Giao thông</div>
      <label class="switch"><input type="checkbox" id="trafficToggle" onchange="toggleTraffic(this.checked)"><span class="slider"></span></label>
    </div>
  </div>
  <button class="fab-report" id="btnReport" onclick="openReportMenu()"><i class="fas fa-exclamation-triangle"></i></button>
  <button class="fab-directions" id="mainDirBtn" onclick="openDirections()"><i class="fas fa-directions"></i></button>
  <div class="dir-sheet" id="dirSheet">
    <div class="dir-handle"></div>
    <div class="input-group" style="margin-top: 10px;">
      <div class="dot start"></div>
      <input type="text" id="dirInputStart" placeholder="Điểm đi (Mặc định GPS)" onclick="activateSearch('start')" />
      <button class="btn-clear-input hidden" id="btnClearStart" onclick="event.stopPropagation(); clearPoint('start')"><i class="fas fa-times"></i></button>
      <button onclick="refreshGPS()"><i class="fas fa-location-arrow" style="color:var(--primary); font-size: 1rem;"></i></button>
    </div>
    <div class="input-group">
      <div class="dot end"></div>
      <input type="text" id="dirInputEnd" placeholder="Điểm đến" onclick="activateSearch('end')" />
      <button class="btn-clear-input hidden" id="btnClearEnd" onclick="event.stopPropagation(); clearPoint('end')"><i class="fas fa-times"></i></button>
    </div>
    <div class="vehicle-selector">
      <button class="vehicle-mode-btn active" data-mode="driving" onclick="setVehicleMode('driving', this)"><i class="fas fa-car"></i> Ô tô</button>
      <button class="vehicle-mode-btn" data-mode="driving-traffic" onclick="setVehicleMode('driving-traffic', this)"><i class="fas fa-car-side"></i> Kẹt xe</button>
      <button class="vehicle-mode-btn" data-mode="hd" onclick="setVehicleMode('hd', this)"><i class="fas fa-motorcycle"></i> Xe CN</button>
      <button class="vehicle-mode-btn" data-mode="truck" onclick="setVehicleMode('truck', this)"><i class="fas fa-truck"></i> Xe tải</button>
      <button class="vehicle-mode-btn" data-mode="bus" onclick="setVehicleMode('bus', this)"><i class="fas fa-bus"></i> Xe buýt</button>
      <button class="vehicle-mode-btn" data-mode="motorcycle" onclick="setVehicleMode('motorcycle', this)"><i class="fas fa-motorcycle"></i> Xe máy</button>
      <button class="vehicle-mode-btn" data-mode="walking" onclick="setVehicleMode('walking', this)"><i class="fas fa-walking"></i> Đi bộ</button>
      <button class="vehicle-mode-btn" data-mode="bicycle" onclick="setVehicleMode('bicycle', this)"><i class="fas fa-bicycle"></i> Xe đạp</button>
    </div>
    <!-- V10: Tham so xe da chuyen sang #vehicleParamsSheet, khong hien inline trong dirSheet -->
    <!-- V9: BUOC DAU CHI CO Xem tat ca - KHONG CO nut Bat dau dan duong o day. Nut Bat dau chi nam trong #routePreviewSheet (JS tu tao) sau khi chon tuyen 1/2/3 -->
    <button id="btnViewAllRoutesStep1" class="btn-auth btn-email v9-viewall-btn" style="margin-top:6px; margin-bottom:0;" onclick="fetchAndShowRouteOptions()"><i class="fas fa-search-location"></i> Xem tất cả tuyến đường</button>
    </div>
  <div class="suggestions-box" id="suggestionsBox"></div>
  <div class="hidden" id="hud">
    <div class="hud-top">
      <div class="hud-stat"><span class="label">Còn lại</span><span class="value" id="hudRemainDist">—</span></div>
      <div class="hud-stat"><span class="label">Đến nơi</span><span class="value" id="hudRemainTime">—</span></div>
      <div class="hud-stat speed"><span class="label">Tốc độ</span><span class="value" id="hudSpeed">0 km/h</span></div>
      <button class="hud-end-btn-top" onclick="openEndTripModal()"><i class="fas fa-flag-checkered"></i><span>Kết thúc</span></button>
    </div>
    <div class="hud-next">
      <div class="arrow" id="hudNextArrow">↑</div>
      <div class="info"><div class="dist" id="hudNextDist">—</div><div class="instr" id="hudNextInstr">Đang tải...</div></div>
    </div>
    <div class="hud-bottom">
      <div class="hud-next-stop"><div class="name" id="hudNextStopName">—</div><div class="dist" id="hudNextStopDist">—</div></div>
      <div class="hud-btn-group">
        
        <button class="hud-btn" id="hudBtnVoice"><i class="fas fa-volume-up"></i></button>
      </div>
    </div>
  </div>
</div>
<div class="route-options-modal" id="routeOptionsModal">
  <div class="route-options-header"><h2><i class="fas fa-route"></i> Các tuyến đường gợi ý</h2><button class="report-close" onclick="closeRouteOptions()" style="background:var(--bg-2);color:var(--text);"><i class="fas fa-times"></i></button></div>
  <div class="route-options-body" id="routeOptionsBody"></div>
</div>
<div class="report-modal" id="reportModal">
  <div class="report-header"><h2>Báo cáo sự cố</h2><button class="report-close" onclick="closeReportMenu()"><i class="fas fa-times"></i></button></div>
  <div class="report-body" style="grid-template-columns: repeat(3, 1fr);">
    <button class="report-btn police" onclick="submitReport('police')"><i class="fas fa-shield-alt" style="color:#3b82f6;"></i> CSGT</button>
    <button class="report-btn accident" onclick="submitReport('accident')"><i class="fas fa-car-crash" style="color:#ef4444;"></i> Tai nạn</button>
    <button class="report-btn traffic" onclick="submitReport('traffic')"><i class="fas fa-traffic-light" style="color:#f97316;"></i> Kẹt xe</button>
    <button class="report-btn" onclick="openSignsMenu()" style="background: linear-gradient(135deg, #f59e0b, #d97706); color: white; border: none;"><i class="fas fa-triangle-exclamation" style="color:white;"></i> Biển báo</button>
    <button class="report-btn pothole" onclick="submitReport('pothole')"><i class="fas fa-exclamation-circle" style="color:#f59e0b;"></i> Ổ gà</button>
    <button class="report-btn" onclick="submitReport('flood')"><i class="fas fa-water" style="color:#06b6d4;"></i> Ngập nước</button>
    <button class="report-btn" onclick="submitReport('bridge_collapse')"><i class="fas fa-road-circle-xmark" style="color:#dc2626;"></i> Sập cầu</button>
    <button class="report-btn" onclick="submitReport('road_collapse')"><i class="fas fa-triangle-exclamation" style="color:#b91c1c;"></i> Sập đường</button>
  </div>
</div>
<div class="report-modal" id="signsMenuModal" style="z-index: 2600;">
  <div class="report-header" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
    <h2>Chọn loại biển báo</h2><button class="report-close" onclick="closeSignsMenu()"><i class="fas fa-times"></i></button>
  </div>
  <div class="report-body" style="display:flex; flex-direction:column; gap:12px; padding:20px;">
    <button class="report-btn" onclick="selectSignsType('speed_camera')" style="flex-direction:row; justify-content:flex-start; padding:16px;"><i class="fas fa-camera" style="color:#e11d48;"></i> <span style="margin-left:12px; font-size:1rem;">Camera tốc độ</span></button>
    <button class="report-btn" onclick="selectSignsType('penalty_camera')" style="flex-direction:row; justify-content:flex-start; padding:16px;"><i class="fas fa-video" style="color:#8b5cf6;"></i> <span style="margin-left:12px; font-size:1rem;">Camera phạt nguội</span></button>
    <button class="report-btn" onclick="selectSignsType('speed_limit')" style="flex-direction:row; justify-content:flex-start; padding:16px;"><i class="fas fa-tachometer-alt" style="color:#10b981;"></i> <span style="margin-left:12px; font-size:1rem;">Biển báo tốc độ</span></button>
    <button class="report-btn" onclick="selectSignsType('toll')" style="flex-direction:row; justify-content:flex-start; padding:16px;"><i class="fas fa-money-bill" style="color:#f59e0b;"></i> <span style="margin-left:12px; font-size:1rem;">Trạm thu phí</span></button>
  </div>
</div>
<div class="report-modal" id="speedLimitModal" style="z-index: 2700;">
  <div class="report-header" style="background: #10b981;"><h2>Chọn tốc độ tối đa</h2><button class="report-close" onclick="closeSpeedLimitMenu()"><i class="fas fa-times"></i></button></div>
  <div class="report-body" style="grid-template-columns: repeat(4, 1fr); gap:8px; padding:20px;">
    <button class="report-btn" onclick="submitSpeedLimit(10)">10</button>
    <button class="report-btn" onclick="submitSpeedLimit(15)">15</button>
    <button class="report-btn" onclick="submitSpeedLimit(20)">20</button>
    <button class="report-btn" onclick="submitSpeedLimit(30)">30</button>
    <button class="report-btn" onclick="submitSpeedLimit(40)">40</button>
    <button class="report-btn" onclick="submitSpeedLimit(50)">50</button>
    <button class="report-btn" onclick="submitSpeedLimit(60)">60</button>
    <button class="report-btn" onclick="submitSpeedLimit(70)">70</button>
    <button class="report-btn" onclick="submitSpeedLimit(80)">80</button>
    <button class="report-btn" onclick="submitSpeedLimit(90)">90</button>
    <button class="report-btn" onclick="submitSpeedLimit(100)">100</button>
    <button class="report-btn" onclick="submitSpeedLimit(110)">110</button>
    <button class="report-btn" onclick="submitSpeedLimit(120)">120</button>
  </div>
</div>
<div class="report-modal" id="nearbySearchPanel" style="z-index: 2600;">
  <div class="report-header" style="background: linear-gradient(135deg, #f59e0b, #d97706);"><h2><i class="fas fa-street-view"></i> Tìm kiếm xung quanh</h2><button class="report-close" onclick="closeNearbySearchPanel()"><i class="fas fa-times"></i></button></div>
  <div class="report-body" style="display:flex; flex-direction:column; gap:16px; padding:20px;">
    <div style="display:flex; gap:10px;">
      <button class="btn btn-primary" onclick="setNearbyCenterToGPS()" style="flex:1; padding:12px; border-radius:10px; font-weight:700; background:var(--primary); color:white;"><i class="fas fa-location-arrow"></i> Vị trí của tôi</button>
      <button class="btn btn-outline" id="btnPickOnMap" onclick="toggleNearbyPickMode()" style="flex:1; padding:12px; border-radius:10px; font-weight:700; border: 1px solid var(--border); color: var(--text); background:transparent;"><i class="fas fa-map-marker-alt"></i> Chọn điểm khác</button>
    </div>
    <div class="form-group">
      <label>Danh mục tìm kiếm</label>
      <select id="nearbyCategory" class="form-control" style="padding:12px; border-radius:10px; background:var(--bg-2); color:var(--text); border:1px solid var(--border); outline:none;">
        <optgroup label="🔥 PHỔ BIẾN NHẤT">
          <option value="restaurant">Nhà hàng</option><option value="cafe">Quán cà phê</option><option value="gas_station">Cây xăng</option><option value="atm">ATM</option><option value="bank_or_credit_union">Ngân hàng</option><option value="hospital">Bệnh viện</option><option value="pharmacy_and_drug_store">Nhà thuốc</option><option value="superstore">Siêu thị</option><option value="convenience_store">Cửa hàng tiện lợi</option><option value="hotel">Khách sạn</option><option value="parking">Bãi đỗ xe</option>
        </optgroup>
        <optgroup label="🍔 ĂN UỐNG & GIẢI TRÍ">
          <option value="food_and_drink">Đồ ăn & Thức uống</option><option value="bar">Quán Bar / Pub</option><option value="fast_food_restaurant">Đồ ăn nhanh</option><option value="food_court">Khu ẩm thực</option>
        </optgroup>
        <optgroup label="🛒 MUA SẮM & DỊCH VỤ">
          <option value="shopping">Mua sắm (Chung)</option><option value="shopping_mall">Trung tâm thương mại</option><option value="market">Chợ</option><option value="laundry_service">Dịch vụ giặt ủi</option>
        </optgroup>
        <optgroup label="🏥 Y TẾ & SỨC KHỎE">
          <option value="health_care">Chăm sóc sức khỏe</option><option value="dental_clinic">Phòng khám nha khoa</option><option value="gym">Phòng Gym</option><option value="pharmacy_and_drug_store">Nhà thuốc / Hiệu thuốc</option>
        </optgroup>
        <optgroup label="🚗 GIAO THÔNG & PHƯƠNG TIỆN">
          <option value="ev_charging_station">Trạm sạc xe điện</option><option value="gas_station">Cây xăng</option><option value="airport">Sân bay</option><option value="train_station">Ga tàu hỏa</option><option value="parking">Bãi đỗ xe</option>
        </optgroup>
        <optgroup label="🏫 GIÁO DỤC"><option value="education">Giáo dục</option><option value="college_university">Cao đẳng / Đại học</option><option value="high_school">Trường cấp 3</option><option value="library">Thư viện</option></optgroup>
        <optgroup label="🏛 CƠ QUAN & CỘNG ĐỒNG"><option value="community_and_government">Cộng đồng & Chính phủ</option><option value="police_station">Đồn cảnh sát</option><option value="fire_station">Trạm cứu hỏa</option><option value="post_office">Bưu điện</option><option value="public_restroom">Nhà vệ sinh công cộng</option></optgroup>
      </select>
    </div>
    <div class="form-group" style="background:var(--bg-2); padding:16px; border-radius:10px; border:1px solid var(--border);">
      <label style="display:flex; justify-content:space-between; margin-bottom:8px;"><span>Bán kính tìm kiếm</span><span id="radiusLabel" style="color:var(--primary); font-weight:900;">2.0 km</span></label>
      <input type="range" id="nearbyRadius" min="0.5" max="5.0" step="0.5" value="2.0" oninput="document.getElementById('radiusLabel').textContent = this.value + ' km'" style="width:100%; accent-color:var(--primary);">
    </div>
    <button class="btn btn-primary" onclick="fetchNearbyPlaces()" style="padding:16px; border-radius:10px; font-size:1.1rem; font-weight:800; margin-top:10px; background:var(--primary); color:white;"><i class="fas fa-search"></i> TÌM KIẾM</button>
  </div>
</div>
<div id="nearbyResultsOverlay" onclick="closeNearbyResultsSheet()" style="position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:2700; display:none; opacity:0; transition:opacity 0.3s;"></div>
<div id="nearbyResultsSheet" style="position:fixed; bottom:0; left:0; right:0; z-index:2800; background:var(--card); border-top-left-radius:20px; border-top-right-radius:20px; transform:translateY(100%); transition:transform 0.3s cubic-bezier(0.4,0,0.2,1); display:flex; flex-direction:column; max-height:70vh; box-shadow:0 -10px 40px rgba(0,0,0,0.3); border-top:1px solid var(--border);">
  <div class="sheet-swipe-hint" id="nearbyResultsSwipeHandle"><div class="sheet-swipe-bar"></div><div class="sheet-swipe-text"><span>Vuốt xuống để đóng</span><i class="fas fa-chevron-down"></i></div></div>
  <div style="padding:0 20px 10px; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border);">
    <h3 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0;" id="nearbyResultsTitle">Kết quả</h3>
    <span style="font-size:0.8rem; color:var(--text-muted); font-weight:700;" id="nearbyResultsCount">0 địa điểm</span>
  </div>
  <div id="nearbyResultsList" style="flex:1; overflow-y:auto; padding:16px; display:flex; flex-direction:column; gap:10px;"></div>
</div>
<div class="profile-modal" id="profileModal">
  <div class="profile-header">
    <button class="profile-close" onclick="closeMenu()"><i class="fas fa-times"></i></button>
    <div class="profile-avatar" id="profileAvatar"><i class="fas fa-user"></i></div>
    <div class="profile-name" id="profileName">Đang tải...</div>
    <div class="profile-email" id="profileEmail">...</div>
    <div class="profile-time" id="profileTime">00:00:00</div>
  </div>
  <div class="profile-body">
    <div class="profile-card" id="liveRoomCard">
      <h3><span><i class="fas fa-satellite-dish" style="color:#10b981;"></i> Live Room</span><span class="live-badge-status" id="liveStatusBadge" style="display:none;">OFF</span></h3>
      <div style="display:flex; align-items:center; justify-content:space-between; padding:12px; background:var(--bg-2); border-radius:10px; margin-bottom:12px;">
        <div><div style="font-weight:800; font-size:0.9rem;">Chế độ Live</div><div style="font-size:0.7rem; color:var(--text-muted); margin-top:2px;">Chia sẻ vị trí 6s/lần</div></div>
        <label class="switch"><input type="checkbox" id="liveToggleSwitch" onchange="toggleLiveRoom()"><span class="slider"></span></label>
      </div>
      <div id="liveFeatures" style="opacity:0.4; pointer-events:none; display:flex; flex-direction:column; gap:12px; position:relative;">
        <div id="liveDisabledOverlay" style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(15,23,42,0.85); border-radius:8px; z-index:5; font-size:0.75rem; font-weight:700; color:var(--warning);">🔒 Bật Live để sử dụng</div>
        <div id="liveRoomCodeBox" style="display:none; flex-direction:column; gap:6px;"><label style="font-size:0.75rem; font-weight:700; color:var(--text-muted);">Mã phòng của bạn</label><div style="display:flex; align-items:center; gap:8px; padding:12px; background:var(--bg); border:2px dashed #10b981; border-radius:10px;"><span id="liveRoomCodeText" style="flex:1; text-align:center; font-family:var(--font-mono); font-size:1.3rem; font-weight:900; letter-spacing:4px; color:#10b981;">------</span><button onclick="copyLiveRoomCode()" style="background:#10b981; color:white; border:none; padding:8px 12px; border-radius:6px; font-size:0.75rem; font-weight:700; cursor:pointer;"><i class="fas fa-copy"></i> Copy</button></div></div>
        <div id="liveRoomActions" style="display:flex; flex-direction:column; gap:8px;"><button class="profile-btn" onclick="createLiveRoom()" style="background:var(--primary); color:white; border:none; justify-content:center;"><span><i class="fas fa-plus-circle"></i> Tạo phòng mới</span></button><div style="display:flex; gap:8px;"><input type="text" id="liveJoinCodeInput" placeholder="Nhập mã phòng..." maxlength="6" style="flex:1; padding:10px; background:var(--bg-2); border:1px solid var(--border); border-radius:8px; color:var(--text); font-family:var(--font-mono); font-weight:800; letter-spacing:2px; text-align:center; text-transform:uppercase;"><button onclick="joinLiveRoom()" style="background:var(--success); color:white; border:none; padding:0 16px; border-radius:8px; font-weight:700; cursor:pointer;"><i class="fas fa-sign-in-alt"></i> Vào</button></div></div>
        <div id="livePublicBox" style="display:none; padding:12px; background:var(--bg-2); border-radius:10px; border-left:3px solid var(--warning);"><div style="display:flex; align-items:center; justify-content:space-between;"><div><div style="font-weight:800; font-size:0.85rem;"><i class="fas fa-globe" style="color:var(--warning);"></i> Chế độ Public</div><div style="font-size:0.7rem; color:var(--text-muted); margin-top:2px;">Người trong 10km thấy bạn</div></div><label class="switch"><input type="checkbox" id="livePublicSwitch" onchange="toggleLivePublic()"><span class="slider"></span></label></div></div>
        <div id="liveMembersBox" style="display:none;"><div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;"><label style="font-size:0.75rem; font-weight:700; color:var(--text-muted);">Người đang live</label><span id="liveMemberCount" style="font-size:0.75rem; color:var(--text-muted);">0</span></div><div id="liveMemberList" style="display:flex; flex-direction:column; gap:6px; max-height:200px; overflow-y:auto;"><div style="text-align:center; padding:16px; color:var(--text-muted); font-size:0.75rem;"><i class="fas fa-users" style="font-size:1.5rem; opacity:0.3; display:block; margin-bottom:6px;"></i>Chưa có ai</div></div></div>
        <button id="liveLeaveBtn" onclick="leaveLiveRoom()" style="display:none; width:100%; padding:12px; background:var(--danger); color:white; border:none; border-radius:10px; font-weight:800; cursor:pointer;"><i class="fas fa-sign-out-alt"></i> Rời phòng</button>
      </div>
    </div>
    <button class="profile-btn" onclick="shareRoute()"><span><i class="fas fa-share-alt"></i> Chia sẻ lộ trình hiện tại</span><i class="fas fa-chevron-right"></i></button>
    <div class="profile-btn" style="cursor: default;"><span><i class="fas fa-moon"></i> Chế độ Sáng / Tối</span><label class="switch"><input type="checkbox" id="themeToggle" onchange="toggleTheme()"><span class="slider"></span></label></div>
    <button class="profile-btn" onclick="openSettings()"><span><i class="fas fa-cog"></i> Cài đặt</span><i class="fas fa-chevron-right"></i></button>
    <div class="profile-card"><h3><i class="fas fa-bookmark"></i> Lộ trình đã lưu <button onclick="clearAllSavedRoutes()" style="background:transparent;color:var(--danger);font-size:0.8rem;padding:4px;" title="Xoá tất cả"><i class="fas fa-trash-alt"></i></button></h3><div class="history-list" id="savedRoutesList"><div style="text-align:center; color:var(--text-muted); font-size:0.85rem;">Chưa có lộ trình nào</div></div></div>
    <div class="profile-card"><h3><i class="fas fa-history"></i> Lịch sử chuyến đi <button onclick="clearAllHistory()" style="background:transparent;color:var(--danger);font-size:0.8rem;padding:4px;" title="Xoá tất cả"><i class="fas fa-trash-alt"></i></button></h3><div class="history-list" id="historyList"><div style="text-align:center; color:var(--text-muted); font-size:0.85rem;">Chưa có chuyến đi nào</div></div></div>
    <div class="profile-card"><h3><i class="fas fa-link"></i> Link đã chia sẻ <button onclick="clearAllSharedLinks()" style="background:transparent;color:var(--danger);font-size:0.8rem;padding:4px;" title="Xoá tất cả"><i class="fas fa-trash-alt"></i></button></h3><div class="history-list" id="sharedLinksList"><div style="text-align:center; color:var(--text-muted); font-size:0.85rem;">Chưa có link nào</div></div></div>
    <button class="profile-btn logout" onclick="logout()"><span><i class="fas fa-sign-out-alt"></i> Đăng xuất</span></button>
  </div>
</div>
<div class="end-trip-modal" id="endTripModal">
  <div class="end-trip-box">
    <h2>🏁 Hoàn thành chuyến đi</h2>
    <div class="end-trip-stats">
      <div class="row"><span><i class="fas fa-road"></i> Quãng đường</span><b id="endTripDist">—</b></div>
      <div class="row"><span><i class="fas fa-clock"></i> Thời gian</span><b id="endTripTime">—</b></div>
      <div class="row"><span><i class="fas fa-tachometer-alt"></i> Tốc độ TB</span><b id="endTripAvgSpeed">—</b></div>
      <div class="row"><span><i class="fas fa-map-marker-alt"></i> Điểm đến</span><b id="endTripDest" style="font-size:0.85rem; max-width:160px; text-overflow:ellipsis; overflow:hidden; white-space:nowrap;">—</b></div>
    </div>
    <button class="end-trip-btn save" onclick="endTrip(true)"><i class="fas fa-save"></i> Lưu & Kết thúc</button>
    <button class="end-trip-btn discard" onclick="endTrip(false)"><i class="fas fa-flag-checkered"></i> Kết thúc không lưu</button>
    <button class="end-trip-btn cancel" onclick="closeEndTripModal()"><i class="fas fa-arrow-left"></i> Tiếp tục chuyến đi</button>
  </div>
</div>
<div class="end-trip-modal" id="savePlaceModal">
  <div class="end-trip-box">
    <h2>📍 Lưu địa điểm</h2>
    <p style="text-align: center; color: var(--text-muted); margin-bottom: 16px; font-size: 0.9rem;" id="savePlaceAddress">Đang lấy địa chỉ...</p>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px;">
      <button class="report-btn" onclick="submitSavePlace('home')"><i class="fas fa-home" style="color:#10b981;"></i> Nhà riêng</button>
      <button class="report-btn" onclick="submitSavePlace('cafe')"><i class="fas fa-coffee" style="color:#f59e0b;"></i> Quán Cafe</button>
      <button class="report-btn" onclick="submitSavePlace('restaurant')"><i class="fas fa-utensils" style="color:#ef4444;"></i> Nhà hàng</button>
      <button class="report-btn" onclick="submitSavePlace('company')"><i class="fas fa-building" style="color:#3b82f6;"></i> Công ty</button>
      <button class="report-btn" onclick="submitSavePlace('school')"><i class="fas fa-school" style="color:#8b5cf6;"></i> Trường học</button>
      <button class="report-btn" onclick="submitSavePlace('other')"><i class="fas fa-map-marker-alt" style="color:#64748b;"></i> Khác</button>
    </div>
    <button class="end-trip-btn cancel" onclick="closeSavePlaceModal()"><i class="fas fa-times"></i> Huỷ</button>
  </div>
</div>
<div class="poi-detail-sheet" id="poiDetailSheet">
  <div class="sheet-swipe-hint" id="poiDetailSwipeHandle"><div class="sheet-swipe-bar"></div><div class="sheet-swipe-text"><span>Vuốt xuống để đóng</span><i class="fas fa-chevron-down"></i></div></div>
  <div id="poiDetailContent"></div>
</div>
<div class="poi-sheet" id="poiSheet">
  <div class="sheet-swipe-hint" id="poiSheetSwipeHandle"><div class="sheet-swipe-bar"></div><div class="sheet-swipe-text"><span>Vuốt xuống để đóng</span><i class="fas fa-chevron-down"></i></div></div>
  <h3><i class="fas fa-map-marker-alt" style="color:var(--success);"></i> Thêm địa điểm cộng đồng</h3>
  <div class="poi-coords" id="poiCoords">—</div>
  <div class="poi-tag-grid" id="poiTagGrid">
    <button class="poi-tag-btn" data-tag="supermarket" onclick="selectPoiTag('supermarket', this)"><i class="fas fa-shopping-cart"></i> Siêu thị</button>
    <button class="poi-tag-btn" data-tag="rest_stop" onclick="selectPoiTag('rest_stop', this)" style="border-color: #3b82f6; color: #3b82f6; position: relative;"><i class="fas fa-bed"></i> Trạm nghỉ<span style="position:absolute; top:-6px; right:-6px; background:#3b82f6; color:white; font-size:0.55rem; padding:2px 6px; border-radius:8px; font-weight:800;">HOT</span></button>
    <button class="poi-tag-btn" data-tag="gas_station" onclick="selectPoiTag('gas_station', this)"><i class="fas fa-gas-pump"></i> Cây xăng</button>
    <button class="poi-tag-btn" data-tag="cafe" onclick="selectPoiTag('cafe', this)"><i class="fas fa-coffee"></i> Cafe</button>
    <button class="poi-tag-btn" data-tag="restaurant" onclick="selectPoiTag('restaurant', this)"><i class="fas fa-utensils"></i> Nhà hàng</button>
    <button class="poi-tag-btn" data-tag="pharmacy" onclick="selectPoiTag('pharmacy', this)"><i class="fas fa-prescription-bottle-medical"></i> Nhà thuốc</button>
    <button class="poi-tag-btn" data-tag="atm" onclick="selectPoiTag('atm', this)"><i class="fas fa-money-bill-wave"></i> ATM</button>
    <button class="poi-tag-btn" data-tag="repair" onclick="selectPoiTag('repair', this)"><i class="fas fa-wrench"></i> Sửa xe</button>
    <button class="poi-tag-btn" data-tag="hotel" onclick="selectPoiTag('hotel', this)"><i class="fas fa-hotel"></i> Khách sạn</button>
    <button class="poi-tag-btn" data-tag="hospital" onclick="selectPoiTag('hospital', this)" style="border-color: #e11d48; color: #e11d48; position: relative;"><i class="fas fa-hospital"></i> Bệnh viện<span class="poi-new-badge">MỚI</span></button>
    <button class="poi-tag-btn" data-tag="parking" onclick="selectPoiTag('parking', this)" style="border-color: #0ea5e9; color: #0ea5e9; position: relative;"><i class="fas fa-square-parking"></i> Bãi đỗ<span class="poi-new-badge">MỚI</span></button>
    <button class="poi-tag-btn" data-tag="ev_charging" onclick="selectPoiTag('ev_charging', this)" style="border-color: #84cc16; color: #84cc16; position: relative;"><i class="fas fa-charging-station"></i> Sạc EV<span class="poi-new-badge">MỚI</span></button>
    <button class="poi-tag-btn" data-tag="market" onclick="selectPoiTag('market', this)" style="border-color: #f97316; color: #f97316; position: relative;"><i class="fas fa-store"></i> Cửa hàng<span class="poi-new-badge">MỚI</span></button>
    <button class="poi-tag-btn" data-tag="wc" onclick="selectPoiTag('wc', this)" style="border-color: #14b8a6; color: #14b8a6; position: relative;"><i class="fas fa-restroom"></i> WC<span class="poi-new-badge">MỚI</span></button>
    <button class="poi-tag-btn" data-tag="car_wash" onclick="selectPoiTag('car_wash', this)" style="border-color: #a855f7; color: #a855f7; position: relative;"><i class="fas fa-soap"></i> Rửa xe<span class="poi-new-badge">MỚI</span></button>
    <button class="poi-tag-btn" data-tag="electronics" onclick="selectPoiTag('electronics', this)" style="border-color: #0891b2; color: #0891b2; position: relative;"><i class="fas fa-mobile-screen-button"></i> Điện thoại &amp; Điện tử<span class="poi-new-badge">MỚI</span></button>
    <button class="poi-tag-btn" data-tag="eatery" onclick="selectPoiTag('eatery', this)" style="border-color: #ea580c; color: #ea580c; position: relative;"><i class="fas fa-bowl-food"></i> Quán ăn<span class="poi-new-badge">MỚI</span></button>
  </div>
  <input type="text" class="poi-input-name" id="poiNameInput" placeholder="Nhập tên địa điểm..." maxlength="80" />
  <div class="poi-actions">
    <button class="poi-btn cancel" onclick="closePoiSheet()"><i class="fas fa-times"></i> Huỷ</button>
    <button class="poi-btn save" id="poiSaveBtn" onclick="submitCommunityPoi()" disabled><i class="fas fa-check"></i> Lưu địa điểm</button>
  </div>
</div>
<div class="report-modal" id="settingsModal" style="z-index: 2600;">
  <div class="report-header" style="background: var(--card); border-bottom: 1px solid var(--border); color: var(--text);">
    <h2><i class="fas fa-cog" style="color:var(--primary);"></i> Cài đặt</h2>
    <button class="report-close" style="background:var(--bg-2); color:var(--text);" onclick="closeSettings()"><i class="fas fa-times"></i></button>
  </div>
  <div class="report-body" style="display:flex; flex-direction:column; gap:12px; padding:20px;">
    <button class="settings-row" onclick="openVoiceSettings()">
      <span class="settings-row-left"><span class="settings-row-icon" style="background:rgba(59,130,246,.15); color:#3b82f6;"><i class="fas fa-volume-up"></i></span><span><b>Cài đặt Giọng nói</b><small>Âm lượng, dẫn đường, cảnh báo</small></span></span>
      <i class="fas fa-chevron-right settings-row-arrow"></i>
    </button>
    <button class="settings-row" onclick="openSignDisplaySettings()">
      <span class="settings-row-left"><span class="settings-row-icon" style="background:rgba(239,68,68,.15); color:#ef4444;"><i class="fas fa-traffic-light"></i></span><span><b>Cài đặt hiển thị biển báo</b><small>Bật/tắt biển, chỉ biển tốc độ, cỡ biển</small></span></span>
      <i class="fas fa-chevron-right settings-row-arrow"></i>
    </button>
    <button class="settings-row" onclick="openRouteSettings()">
      <span class="settings-row-left"><span class="settings-row-icon" style="background:rgba(37,99,235,.15); color:#2563eb;"><i class="fas fa-route"></i></span><span><b>Tuyến đường</b><small>Tự động đổi tuyến khi đi sai đường</small></span></span>
      <i class="fas fa-chevron-right settings-row-arrow"></i>
    </button>
  </div>
</div>
<div class="report-modal" id="routeSettingsModal" style="z-index: 2600;">
  <div class="report-header" style="background: var(--card); border-bottom: 1px solid var(--border); color: var(--text);">
    <h2><i class="fas fa-route" style="color:#2563eb;"></i> Tuyến đường</h2>
    <button class="report-close" style="background:var(--bg-2); color:var(--text);" onclick="closeRouteSettings()"><i class="fas fa-times"></i></button>
  </div>
  <div class="report-body" style="display:flex; flex-direction:column; gap:20px; padding:20px;">
    <div class="voice-setting-row"><span class="voice-setting-title"><i class="fas fa-route" style="color:#2563eb;"></i> Tự động đổi tuyến</span><div class="segmented-control" id="seg-autoReroute"><button class="seg-btn" onclick="setAutoRerouteMode('ask')">Hỏi</button><button class="seg-btn" onclick="setAutoRerouteMode('auto')">Tự động đổi</button></div><div style="font-size:.8rem; color:var(--text-muted); margin-top:8px;">Khi phát hiện bạn đi sai tuyến đường: chọn "Hỏi" sẽ hiện popup để bạn chọn, chọn "Tự động đổi" sẽ đổi tuyến ngay không hỏi.</div></div>
  </div>
</div>
<div class="report-modal" id="signDisplaySettingsModal" style="z-index: 2650;">
  <div class="report-header" style="background: var(--card); border-bottom: 1px solid var(--border); color: var(--text);">
    <h2><i class="fas fa-traffic-light" style="color:#ef4444;"></i> Hiển thị biển báo</h2>
    <button class="report-close" style="background:var(--bg-2); color:var(--text);" onclick="closeSignDisplaySettings()"><i class="fas fa-times"></i></button>
  </div>
  <div class="report-body" style="display:flex; flex-direction:column; gap:16px; padding:20px;">
    <div class="voice-setting-row">
      <span class="voice-setting-title"><i class="fas fa-traffic-light" style="color:#ef4444;"></i> Hiện biển báo Mapillary</span>
      <div style="display:flex; align-items:center; justify-content:space-between;">
        <span style="font-size:.8rem; color:var(--text-muted);">Tắt là ẩn hết biển trên map</span>
        <label class="switch"><input type="checkbox" id="signShowSwitch" onchange="setSignShowMapillary(this.checked)"><span class="slider"></span></label>
      </div>
    </div>
    <div class="voice-setting-row">
      <span class="voice-setting-title"><i class="fas fa-tachometer-alt" style="color:#f59e0b;"></i> Chỉ hiện biển tốc độ</span>
      <div style="display:flex; align-items:center; justify-content:space-between;">
        <span style="font-size:.8rem; color:var(--text-muted);">Ẩn biển khác, chỉ giữ biển giới hạn tốc độ</span>
        <label class="switch"><input type="checkbox" id="signSpeedOnlySwitch" onchange="setSignSpeedOnly(this.checked)"><span class="slider"></span></label>
      </div>
    </div>
    <div class="voice-setting-row">
      <span class="voice-setting-title"><i class="fas fa-expand" style="color:#10b981;"></i> Kích thước biển</span>
      <div class="segmented-control">
        <button class="seg-btn" id="signSize-small" onclick="setSignSize('small')">Nhỏ</button>
        <button class="seg-btn" id="signSize-medium" onclick="setSignSize('medium')">Vừa</button>
        <button class="seg-btn" id="signSize-large" onclick="setSignSize('large')">Lớn</button>
      </div>
    </div>
    <button class="btn-auth btn-email" style="margin-top:6px;" onclick="closeSignDisplaySettings()">Xong</button>
  </div>
</div>
<div class="report-modal" id="voiceSettingsModal" style="z-index: 2600;">
  <div class="report-header" style="background: var(--card); border-bottom: 1px solid var(--border); color: var(--text);">
    <h2><i class="fas fa-volume-up" style="color:var(--primary);"></i> Cài đặt Giọng nói</h2>
    <button class="report-close" style="background:var(--bg-2); color:var(--text);" onclick="closeVoiceSettings()"><i class="fas fa-times"></i></button>
  </div>
  <div class="report-body" style="display:flex; flex-direction:column; gap:20px; padding:20px;">
    <div class="form-group" style="background:var(--bg-2); padding:16px; border-radius:12px; border:1px solid var(--border);">
      <label style="display:flex; justify-content:space-between; font-weight:800; font-size:0.95rem;"><span>Âm lượng (Tối đa 200%)</span><span id="voiceVolLabel" style="color:var(--primary); font-weight:900;">100%</span></label>
      <input type="range" id="voiceVolumeSlider" min="0" max="200" step="10" value="100" oninput="updateVoiceVolumeLabel(this.value)" style="width:100%; margin-top:12px; accent-color:var(--primary);">
      <div style="font-size:0.7rem; color:var(--text-muted); margin-top:8px; font-style:italic;">*Một số trình duyệt có thể giới hạn âm lượng tối đa ở 100%.</div>
    </div>
    <div class="voice-setting-row"><span class="voice-setting-title"><i class="fas fa-diamond-turn-right" style="color:#3b82f6;"></i> Dẫn đường</span><div class="segmented-control" id="seg-nav"><button class="seg-btn" onclick="setVoiceMode('nav', 'never')">Không</button><button class="seg-btn" onclick="setVoiceMode('nav', 'always')">Luôn</button><button class="seg-btn" onclick="setVoiceMode('nav', 'vibrate')">Rung</button></div></div>
    <div class="voice-setting-row"><span class="voice-setting-title"><i class="fas fa-exclamation-triangle" style="color:#f59e0b;"></i> Cảnh báo</span><div class="segmented-control" id="seg-warning"><button class="seg-btn" onclick="setVoiceMode('warning', 'never')">Không</button><button class="seg-btn" onclick="setVoiceMode('warning', 'always')">Luôn</button><button class="seg-btn" onclick="setVoiceMode('warning', 'vibrate')">Rung</button></div></div>
    <div class="voice-setting-row"><span class="voice-setting-title"><i class="fas fa-gas-pump" style="color:#10b981;"></i> Trạm xăng / Dừng nghỉ</span><div class="segmented-control" id="seg-poi"><button class="seg-btn" onclick="setVoiceMode('poi', 'never')">Không</button><button class="seg-btn" onclick="setVoiceMode('poi', 'always')">Luôn</button><button class="seg-btn" onclick="setVoiceMode('poi', 'vibrate')">Rung</button></div></div>
    <div class="voice-setting-row"><span class="voice-setting-title"><i class="fas fa-ban" style="color:#ef4444;"></i> Đường cấm</span><div class="segmented-control" id="seg-avoid"><button class="seg-btn" onclick="setVoiceMode('avoid', 'never')">Không</button><button class="seg-btn" onclick="setVoiceMode('avoid', 'always')">Luôn</button><button class="seg-btn" onclick="setVoiceMode('avoid', 'vibrate')">Rung</button></div></div>
    <button class="btn-auth btn-email" style="margin-top:10px;" onclick="closeVoiceSettings()">Lưu & Đóng</button>
  </div>
</div>
<script>
  window.addEventListener('error', function (e) { var t = document.getElementById('loadingText'); if (t) t.textContent = 'Lỗi tải: ' + (e.message || 'không rõ'); });
  setTimeout(function () {
    var ls = document.getElementById('loadingScreen');
    var el = document.getElementById('loadingPercent');
    if (ls && !ls.classList.contains('hidden') && el && el.textContent === '0%') {
      var t = document.getElementById('loadingText'); if (t) t.textContent = 'Không tải được ứng dụng.';
    }
  }, 10000);
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => { navigator.serviceWorker.register('./sw.js').catch(err => console.warn('SW error:', err)); });
  }
</script>

<!-- ========== VEHICLE PARAMS SHEET - V10 ========== -->
<div class="vps-overlay" id="vehicleParamsOverlay" onclick="closeVehicleParamsSheet()"></div>
<div class="vps-sheet" id="vehicleParamsSheet">
  <div class="vps-handle"></div>
  <div class="vps-header">
    <button type="button" class="vps-back-btn" onclick="closeVehicleParamsSheet()">←&nbsp;Quay lại</button>
    <div class="vps-title-wrap"><h3 class="vps-title" id="vpsTitle">Tham số xe hơi</h3><p class="vps-subtitle" id="vpsSubtitle">Ô tô • 5 chỗ</p></div>
    <button type="button" class="vps-close-btn" onclick="closeVehicleParamsSheet()">✕</button>
  </div>
  <div class="vps-body">
    <div class="vps-section" id="vpsCarSection">
      <div class="vps-label"><i class="fas fa-chair" style="color:#3b82f6;"></i> Số chỗ ngồi</div>
      <div class="vps-options" id="vpsCarOptions"></div>
      <p class="vps-hint">Chọn số chỗ để tính tuyến phù hợp với xe của bạn.</p>
    </div>
    <div class="vps-section" id="vpsTruckSection" style="display:none;">
      <div class="vps-label"><i class="fas fa-truck" style="color:#f59e0b;"></i> Số trục xe</div>
      <div class="vps-options" id="vpsTruckOptions"></div>
      <div class="vps-warning"><i class="fas fa-exclamation-triangle"></i><div><b>Lưu ý:</b> Vui lòng tự quan sát biển báo cấm tải trên thực tế!</div></div>
    </div>
    <div class="vps-section" id="vpsBusSection" style="display:none;">
      <div class="vps-label"><i class="fas fa-bus" style="color:#8b5cf6;"></i> Loại xe buýt</div>
      <div class="vps-options" id="vpsBusOptions"></div>
    </div>
  </div>
  <div class="vps-footer"><button type="button" class="vps-done-btn" onclick="closeVehicleParamsSheet()">Xong</button></div>
</div>

<!-- PHAI LA type="module" - app.js co 4 dong import firebase, doi sang script thuong la loi ngay. Moi onclick="..." trong HTML da duoc window.xxx = ... trong app.js nen van chay duoc -->
<script type="module" src="data:application/javascript;base64,"></script>
</body>
</html>
